<Application x:Class="AppLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="..\resources\icons\app.ico"
                        ToolTipText="AppLauncher">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="吸着位置の指定">
                        <MenuItem Header="右" Click="OnSnapRight"/>
                        <MenuItem Header="左" Click="OnSnapLeft"/>
                        <MenuItem Header="上" Click="OnSnapTop"/>
                        <MenuItem Header="下" Click="OnSnapBottom"/>
                    </MenuItem>
                    <MenuItem Header="ピンモード切替" Click="OnTogglePin"/>
                    <Separator/>
                    <MenuItem Header="終了" Click="OnExit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
