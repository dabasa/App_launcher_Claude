<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AppLauncher</RootNamespace>
    <AssemblyName>AppLauncher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\resources\icons\app.ico</ApplicationIcon>
    <!-- バージョン・メタ情報 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>AppLauncher</Product>
    <Description>アプリランチャー</Description>
    <Copyright>Copyright © 2026 dabasa1942</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE;DEBUG_TILES</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- タスクトレイアイコン -->
    <Resource Include="..\resources\icons\app.ico" Link="resources/icons/app.ico"/>
    <!-- モード切替ボタン画像 -->
    <Resource Include="..\resources\image\mode01chg.png" Link="resources/image/mode01chg.png"/>
    <Resource Include="..\resources\image\mode02chg.png" Link="resources/image/mode02chg.png"/>
    <Resource Include="..\resources\image\mode03chg.png" Link="resources/image/mode03chg.png"/>
  </ItemGroup>

</Project>
