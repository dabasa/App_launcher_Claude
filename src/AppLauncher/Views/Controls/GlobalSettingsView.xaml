<UserControl x:Class="AppLauncher.Views.Controls.GlobalSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <TextBlock Grid.Row="0"
                   Text="全体設定" FontSize="14" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Right"
                   Margin="0,12,16,8"/>

        <!-- 設定フォーム -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel Margin="16,0,16,8" DataContext="{Binding GlobalSettingsVm}">

                <!-- タスクトレイ常駐 -->
                <CheckBox Content="タスクトレイ常駐" IsChecked="{Binding TaskTrayResident}"
                          Foreground="White" Margin="0,8,0,4"/>

                <!-- Windows 起動時の自動起動 -->
                <CheckBox Content="Windows 起動時に自動起動" IsChecked="{Binding StartWithWindows}"
                          Foreground="White" Margin="0,4,0,8"/>

                <!-- タイル配置数 -->
                <TextBlock Text="タイル配置数" Foreground="White" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="横：" Foreground="White" VerticalAlignment="Center"/>
                    <Slider Minimum="4" Maximum="16" Value="{Binding TileCountCols}"
                            Width="120" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding TileCountCols}" Foreground="White"
                               Width="24" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="縦：" Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Slider Minimum="4" Maximum="16" Value="{Binding TileCountRows}"
                            Width="120" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding TileCountRows}" Foreground="White"
                               Width="24" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- タイル間マージン -->
                <TextBlock Text="タイル間マージン（px）" Foreground="White" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="30" Value="{Binding TileMargin}"
                            Width="200" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding TileMargin}" Foreground="White"
                               Width="24" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- ページ名フォントサイズ -->
                <TextBlock Text="ページ名フォントサイズ（pt）" Foreground="White" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="6" Maximum="72" Value="{Binding PageNameFontSizePt}"
                            Width="200" VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding PageNameFontSizePt}" Foreground="White"
                               Width="24" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 吸着位置 -->
                <TextBlock Text="吸着位置" Foreground="White" Margin="0,8,0,4"/>
                <ComboBox ItemsSource="{Binding SnapPositions}"
                          SelectedItem="{Binding SnapPosition}"
                          Width="120" HorizontalAlignment="Left"/>

                <!-- 収納待ち時間 -->
                <TextBlock Text="収納待ち時間（ms）" Foreground="White" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="3000" Value="{Binding StorageDelayMs}"
                            Width="200" VerticalAlignment="Center" TickFrequency="100" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding StorageDelayMs}" Foreground="White"
                               Width="32" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- OK / キャンセル -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,16,12">
            <Border x:Name="OkButton" Width="80" Height="32" Margin="0,0,8,0"
                    CornerRadius="6" Cursor="Hand">
                <TextBlock Text="OK" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="CancelButton" Width="80" Height="32"
                    CornerRadius="6" Cursor="Hand">
                <TextBlock Text="キャンセル" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
