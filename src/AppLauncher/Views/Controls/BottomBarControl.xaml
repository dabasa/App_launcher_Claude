<UserControl x:Class="AppLauncher.Views.Controls.BottomBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 行1（常時）＋ 行2（編集モード時のみ）の縦積み -->
    <StackPanel Orientation="Vertical">

        <!-- ═══ 行1 ═══════════════════════════════════════════════════ -->
        <Grid Height="32">
            <!-- ページインジケーター（中央） -->
            <StackPanel x:Name="IndicatorPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

            <!-- 右側ボタン群（固定列 Grid でボタン位置を固定） -->
            <Grid HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>  <!-- PageEdit: 32px + 右マージン8px -->
                    <ColumnDefinition Width="40"/>  <!-- Settings: 32px + 右マージン8px -->
                    <ColumnDefinition Width="32"/>  <!-- ModeButton: 常時表示 -->
                </Grid.ColumnDefinitions>

                <!-- ページ編集ボタン（列幅を確保したまま非表示） -->
                <Border x:Name="PageEditButton"
                        Grid.Column="0"
                        Width="32" Height="32"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Visibility="Hidden"/>

                <!-- 全体設定ボタン（列幅を確保したまま非表示） -->
                <Border x:Name="GlobalSettingsButton"
                        Grid.Column="1"
                        Width="32" Height="32"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Visibility="Hidden"/>

                <!-- モード切替ボタン（常に Col=2 に固定） -->
                <Border x:Name="ModeButton"
                        Grid.Column="2"
                        Width="32" Height="32"
                        Cursor="Hand">
                    <Image x:Name="ModeButtonImage" Stretch="Uniform" Margin="3"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ 行2：ページ管理コントロール（編集モード時のみ表示） ════ -->
        <Grid x:Name="PageMgmtRow"
              Height="25"
              Margin="0,8,0,0"
              Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Border x:Name="MoveLeftButton"
                        Width="25" Height="25"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>

                <Border x:Name="AddPageButton"
                        Width="25" Height="25"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>

                <Border x:Name="RemovePageButton"
                        Width="25" Height="25"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>

                <Border x:Name="MoveRightButton"
                        Width="25" Height="25"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

    </StackPanel>
</UserControl>
