<UserControl x:Class="AppLauncher.Views.Controls.FontDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:AppLauncher.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:FontNameDisplayConverter  x:Key="FontNameDisplay"/>
        <helpers:FontNameToFamilyConverter x:Key="FontNameToFamily"/>
    </UserControl.Resources>

    <!-- 半透明オーバーレイ背景 -->
    <Grid Background="#BB000000">
        <!-- ダイアログカード -->
        <Border Margin="12" VerticalAlignment="Center"
                CornerRadius="10" Background="#FF252525"
                BorderBrush="#60FFFFFF" BorderThickness="1">
            <StackPanel Margin="16,14,16,14">

                <!-- ダイアログタイトル -->
                <TextBlock Text="{Binding DialogTitle}"
                           Foreground="#F0F0F0" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <!-- フォント名 -->
                <TextBlock Text="フォント名" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                <ComboBox x:Name="FontNameCombo"
                          ItemsSource="{Binding FontFamilies}"
                          SelectedItem="{Binding FontName, UpdateSourceTrigger=PropertyChanged}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Standard"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                          Margin="0,0,0,10">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Height"   Value="22"/>
                            <Setter Property="Padding"  Value="4,0"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FontNameDisplay}}"
                                       FontFamily="{Binding Converter={StaticResource FontNameToFamily}}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- フォントサイズ（自動調整ON時はグレーアウト） -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="1.0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutoFontSize}" Value="True">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="フォントサイズ" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="6" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding FontSizePt, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding FontSizeSliderEnabled}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Foreground="#F0F0F0" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="4,0,0,0">
                            <Run Text="{Binding FontSizePt, Mode=OneWay}"/><Run Text=" pt"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <!-- 自動調整チェック -->
                <CheckBox Content="フォントサイズを自動調整する（はみ出す場合のみ縮小）"
                          IsChecked="{Binding AutoFontSize, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="#F0F0F0" Margin="0,0,0,12"/>

                <!-- フォントカラー -->
                <TextBlock Text="フォントカラー" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3"/>
                <ComboBox x:Name="FontColorCombo"
                          ItemsSource="{Binding ColorItems}"
                          SelectedValue="{Binding FontColor, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Name"
                          Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="14" Margin="0,0,6,0"
                                        CornerRadius="2" Background="{Binding Brush}"/>
                                <TextBlock Text="{Binding Name}" Foreground="#2D2D2D"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- プレビュー -->
                <Border Background="#FF1A1A1A" CornerRadius="6" Padding="8,6"
                        MinHeight="50" Margin="0,0,0,14">
                    <TextBlock Text="{Binding PreviewText}"
                               Foreground="{Binding PreviewForeground}"
                               FontSize="{Binding PreviewFontSize}"
                               FontFamily="{Binding PreviewFontFamily}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- OK / キャンセルボタン -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DialogCancelButton" Grid.Column="0"
                            Height="30" CornerRadius="6" Cursor="Hand">
                        <TextBlock Text="キャンセル" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                    <Border x:Name="DialogOkButton" Grid.Column="2"
                            Height="30" CornerRadius="6" Cursor="Hand">
                        <TextBlock Text="OK" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
