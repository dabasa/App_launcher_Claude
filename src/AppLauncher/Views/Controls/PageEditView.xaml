<UserControl x:Class="AppLauncher.Views.Controls.PageEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:AppLauncher.Helpers"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <helpers:ColorNameConverter x:Key="ColorNameConverter"/>

        <!-- カラー選択プルダウン共通テンプレート（カラーブロック付き） -->
        <DataTemplate x:Key="ColorOptionTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="14" Height="14" Margin="0,0,6,0" RadiusX="3" RadiusY="3"
                           VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{Binding Converter={StaticResource ColorNameConverter}}"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- ヘッダー行（プレビュー＋ラベル） -->
            <RowDefinition Height="*"/>     <!-- 設定フォーム -->
            <RowDefinition Height="Auto"/>  <!-- OK / キャンセル -->
        </Grid.RowDefinitions>

        <!-- ─── 行0：プレビュー（左）＋ モード名ラベル（右） ──────────────── -->
        <Grid Grid.Row="0" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- プレビュータイル（2×1 = 200×96 px） -->
            <Border x:Name="PreviewBorder"
                    Grid.Column="0"
                    Width="200" Height="96"
                    CornerRadius="10"
                    HorizontalAlignment="Left">
                <TextBlock x:Name="PreviewName"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- モード名ラベル -->
            <TextBlock Grid.Column="1"
                       Text="ページ設定"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- ─── 行1：設定フォーム ──────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel Margin="16,0,16,8" DataContext="{Binding PageEditVm}">

                <!-- 背景色 -->
                <TextBlock Text="背景色" Foreground="White" Margin="0,8,0,4"/>
                <ComboBox ItemsSource="{Binding ColorOptions}"
                          SelectedItem="{Binding BackgroundColor}"
                          Width="180" HorizontalAlignment="Left"
                          ItemTemplate="{StaticResource ColorOptionTemplate}"/>

                <!-- 背景不透明度 -->
                <TextBlock Text="背景不透明度（%）" Foreground="White" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="90" Value="{Binding BackgroundOpacity}"
                            Width="180" VerticalAlignment="Center"
                            TickFrequency="10" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding BackgroundOpacity}" Foreground="White"
                               Width="32" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- ハンドル色 -->
                <TextBlock Text="ハンドル色" Foreground="White" Margin="0,8,0,4"/>
                <ComboBox ItemsSource="{Binding ColorOptions}"
                          SelectedItem="{Binding HandleColor}"
                          Width="180" HorizontalAlignment="Left"
                          ItemTemplate="{StaticResource ColorOptionTemplate}"/>

                <!-- ハンドル不透明度 -->
                <TextBlock Text="ハンドル不透明度（%）" Foreground="White" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="90" Value="{Binding HandleOpacity}"
                            Width="180" VerticalAlignment="Center"
                            TickFrequency="10" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding HandleOpacity}" Foreground="White"
                               Width="32" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- ピン枠色 -->
                <TextBlock Text="ピン枠色" Foreground="White" Margin="0,8,0,4"/>
                <ComboBox ItemsSource="{Binding ColorOptions}"
                          SelectedItem="{Binding PinFrameColor}"
                          Width="180" HorizontalAlignment="Left"
                          ItemTemplate="{StaticResource ColorOptionTemplate}"/>

                <!-- ピン枠不透明度 -->
                <TextBlock Text="ピン枠不透明度（%）" Foreground="White" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="90" Value="{Binding PinFrameOpacity}"
                            Width="180" VerticalAlignment="Center"
                            TickFrequency="10" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding PinFrameOpacity}" Foreground="White"
                               Width="32" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ─── 行2：OK / キャンセル ──────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,8,16,12">
            <Border x:Name="OkButton" Width="80" Height="32" Margin="0,0,8,0"
                    CornerRadius="6" Cursor="Hand">
                <TextBlock Text="OK" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="CancelButton" Width="80" Height="32"
                    CornerRadius="6" Cursor="Hand">
                <TextBlock Text="キャンセル" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
