<Window x:Class="AppLauncher.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AppLauncher.Views.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SizeToContent="Manual">

    <!--
        吸着方向に応じてコードビハインドで列・行を切り替え
        左右吸着: 列0=ハンドル or フレーム, 列1=ギャップ, 列2=フレーム or ハンドル
        上下吸着: 行0=フレーム or ハンドル, 行1=ギャップ, 行2=ハンドル or フレーム
    -->
    <Grid x:Name="WindowRoot"
          ClipToBounds="True">
        <Grid x:Name="RootGrid"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/> <!-- handle (right/left snap) / full width (top/bottom snap) -->
            <ColumnDefinition Width="8"/>  <!-- gap -->
            <ColumnDefinition Width="*"/>  <!-- frame -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>  <!-- frame (top snap) / full height (left/right snap) -->
            <RowDefinition Height="0"/>  <!-- gap (top/bottom snap) -->
            <RowDefinition Height="0"/>  <!-- handle (top snap) -->
        </Grid.RowDefinitions>

        <!--
            ハンドルとフレームの間の透明ギャップ（HandleFrameMargin 分）は
            AllowsTransparency=True ウィンドウでは alpha=0 となりクリックスルーになる。
            OS がギャップへのマウス侵入を「ウィンドウ離脱」と誤認して WM_MOUSELEAVE を
            早期発行し、その後ウィンドウ外への離脱を検知できなくなる問題を防ぐため、
            ウィンドウ全体を alpha=1（視認不能）で覆い完全なクリックスルーを防ぐ。
        -->
        <Rectangle Grid.ColumnSpan="3" Grid.RowSpan="3"
                   Panel.ZIndex="-1"
                   Fill="#01000000"
                   IsHitTestVisible="False"/>

        <!-- ハンドル -->
        <controls:HandleControl x:Name="Handle"
                                Grid.Column="0" Grid.Row="0"
                                VerticalAlignment="Center"/>

        <!-- ランチャーフレーム：角丸・黒枠2px（ピンモード時は枠を色変更・太く） -->
        <Border x:Name="Frame"
                Grid.Column="2" Grid.Row="0"
                CornerRadius="20"
                BorderBrush="#FF000000"
                BorderThickness="2"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8"/>    <!-- pageNameTopMargin -->
                    <RowDefinition Height="Auto"/> <!-- PageNameControl -->
                    <RowDefinition Height="8"/>    <!-- pageNameBottomMargin -->
                    <RowDefinition Height="*"/>    <!-- TileGridControl -->
                    <RowDefinition Height="8"/>    <!-- bottomBarTopMargin -->
                    <RowDefinition Height="Auto"/> <!-- BottomBarControl -->
                    <RowDefinition Height="8"/>    <!-- bottomBarBottomMargin -->
                </Grid.RowDefinitions>

                <controls:PageNameControl Grid.Row="1" Margin="20,0"/>
                <controls:TileGridControl Grid.Row="3" Margin="20,0"
                                          DataContext="{Binding DisplayPage}"/>
                <controls:BottomBarControl Grid.Row="5"/>

                <!-- タイル詳細設定パネル（TileEdit モード時に Frame 内全体に表示） -->
                <controls:TileEditControl x:Name="TileEditPanel"
                                          Grid.RowSpan="7"
                                          Visibility="Collapsed"
                                          Panel.ZIndex="50"/>

                <!-- ページ設定パネル（PageEdit モード時に Frame 内全体に表示） -->
                <controls:PageEditView x:Name="PageEditPanel"
                                       Grid.RowSpan="7"
                                       Visibility="Collapsed"
                                       Panel.ZIndex="50"/>

                <!-- 全体設定パネル（GlobalSettings モード時に Frame 内全体に表示） -->
                <controls:GlobalSettingsView x:Name="GlobalSettingsPanel"
                                             Grid.RowSpan="7"
                                             Visibility="Collapsed"
                                             Panel.ZIndex="50"/>

                <!-- 削除確認ダイアログ（Frame 内全体に重なるオーバーレイ） -->
                <Grid x:Name="DeleteConfirmOverlay"
                      Grid.RowSpan="7"
                      Visibility="Collapsed"
                      Panel.ZIndex="100"
                      Background="#80000000">
                    <Border Width="300" Height="140"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#FF8C9BAB" CornerRadius="10">
                        <StackPanel VerticalAlignment="Center" Margin="20">
                            <TextBlock Text="タイルを削除しますがよろしいですか？"
                                       Foreground="White" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border x:Name="DeleteOkButton"
                                        Width="80" Height="32" Margin="0,0,8,0"
                                        Background="#FFE05252" CornerRadius="6" Cursor="Hand">
                                    <TextBlock Text="OK" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="DeleteCancelButton"
                                        Width="80" Height="32"
                                        Background="#FF6D7880" CornerRadius="6" Cursor="Hand">
                                    <TextBlock Text="キャンセル" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="TransitionOverlay"
                        Grid.RowSpan="7"
                        CornerRadius="{Binding CornerRadius, ElementName=Frame}"
                        Visibility="Collapsed"
                        Panel.ZIndex="999"
                        IsHitTestVisible="True"/>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
